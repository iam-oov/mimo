# general
DAILY_RECOMMENDATIONS_LIMIT=3
DEBATE_MIN_CHARACTER=150
DEBATE_MAX_CHARACTER=250

# db (only for docker-compose)
POSTGRES_DB=mimo
POSTGRES_USER=mimo
POSTGRES_PASSWORD=mimo_local_dev

# db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mimo_db

# llm keys
GEMINI_API_KEY=your-gemini-api-key-here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# google oauth
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

SECRET_KEY=your-secret-key-here-change-this-in-production
